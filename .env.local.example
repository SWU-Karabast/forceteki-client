# Copy this file to .env.local and customize for your development environment
# .env.local won't be committed to git (see .gitignore)
# Restart the dev server after changes; sign in again if the secret or hostname changes.

# Backend URL, without a trailing slash. Use the same hostname as the frontend for cookies.
NEXT_PUBLIC_ROOT_URL=http://localhost:9500

# Frontend URL: must match the address you open in the browser (see README for mobile testing).
NEXTAUTH_URL=http://localhost:3000

# Must match NEXTAUTH_SECRET in the backend .env. This default is for local development only.
# For other environments, generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=verysecret

# Other custom settings

# Disables the quick match panel for local testing -- its harder to see 3 panels on small screens, we can skip this one
# NEXT_PUBLIC_DISABLE_LOCAL_QUICK_MATCH=true

# Set to true to display the BreakpointOverlay for responsive design debugging
# NEXT_PUBLIC_SHOW_BREAKPOINT_OVERLAY=true

# Set to true to display debug borders
# NEXT_PUBLIC_DEBUG_BORDERS=true

# Set to true to display detailed hand scaling debug info
# NEXT_PUBLIC_DEBUG_HAND_SCALING=true

# AWS Configuration for S3 Cosmetics Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
REGION=us-east-1

#NOTE: the following settings are for local development of Cosmetics storage and integraation with local DynamoDB and S3 mocks.
# Local S3 Configuration (for development with Adobe S3Mock)
# Set USE_LOCAL_S3=true to use local S3-compatible storage instead of AWS S3
# USE_LOCAL_S3=true
